{
  "manifestVersion": 2,
  "id": "official.the-world",
  "participation": "timeline",
  "version": "0.1.4",
  "displayName": "The World",
  "icon": "./icon.png",
  "description": "Loom Studio 官方世界状态扩展：地点、场景、时间、日历、背景与天气的 State / EC 数据层。",
  "author": "Loom Studio",
  "engines": {
    "studio": "^0.1.0"
  },
  "tags": [
    "world",
    "map",
    "weather"
  ],
  "modules": [
    {
      "id": "client",
      "runtime": "client",
      "entry": "./dist/client.js",
      "contributes": {
        "commands": [
          {
            "id": "official.the-world.open-panel",
            "title": "打开 The World 面板",
            "icon": "image"
          }
        ],
        "renderers": [
          {
            "id": "official.the-world.debugger",
            "name": "The World 调试台",
            "surface": "shell.focus-surface",
            "instanceScope": "workspace",
            "adapter": "shadow",
            "fallback": "hidden"
          }
        ],
        "actions": [
          {
            "commandId": "official.the-world.open-panel",
            "surface": "stage.header.actions",
            "group": "world",
            "suggestedOrder": 10
          }
        ]
      }
    },
    {
      "id": "server",
      "runtime": "server",
      "entry": "./src/server/index.js",
      "capabilities": {
        "state.read": true,
        "state.write": true,
        "state.contribute": true
      },
      "contributes": {
        "rpc": [
          {
            "name": "official.the-world.readWorldState"
          },
          {
            "name": "official.the-world.writeWorldState"
          },
          {
            "name": "official.the-world.previewWorldUpgrade"
          },
          {
            "name": "official.the-world.commitWorldUpgrade"
          }
        ],
        "agentToolHandlers": [
          {
            "toolId": "official.the-world/read-world-state"
          },
          {
            "toolId": "official.the-world/update-world-state"
          }
        ]
      }
    }
  ],
  "contributes": {
    "promptResources": [
      {
        "id": "world-state-maintenance",
        "resourceKind": "lore",
        "source": "./resources/world-state-maintenance.lore.json"
      }
    ],
    "settings": [
      {
        "id": "weather-effects-enabled",
        "type": "boolean",
        "label": "启用天气效果",
        "description": "控制已采用 The World 的当前故事天色、天气粒子和云层。",
        "default": true,
        "group": "显示",
        "suggestedOrder": 10
      }
    ],
    "agentTools": [
      {
        "id": "official.the-world/read-world-state",
        "source": "./resources/agent-tools/read-world-state.json"
      },
      {
        "id": "official.the-world/update-world-state",
        "source": "./resources/agent-tools/update-world-state.json"
      }
    ]
  }
}
